{
  "manifestVersion": 2,
  "id": "buildkite-orca-plugin",
  "name": "Buildkite",
  "version": "1.0.1",
  "description": "Buildkite builds for the active workspace, in a sidebar panel.",
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "buildkite-orca-plugin",
        "title": "Buildkite",
        "icon": "blocks",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "events": [
      { "on": "workspace.changed" }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    },
    {
      "kind": "secrets:own"
    },
    {
      "kind": "workspace:read"
    }
  ]
}
