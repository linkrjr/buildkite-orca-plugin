{
  "manifestVersion": 2,
  "id": "buildkite-orca-plugin",
  "name": "Buildkite",
  "version": "0.1.0",
  "description": "Buildkite builds for the active workspace, in a sidebar panel.",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "buildkite-orca-plugin",
        "title": "Buildkite",
        "icon": "blocks",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    },
    {
      "kind": "secrets:own"
    }
  ]
}
